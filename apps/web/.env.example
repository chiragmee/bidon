# apps/web — copy to .env.local. Only NEXT_PUBLIC_* values reach the browser; never put secrets here.
# demo = in-browser seeded data (no backend needed) | http = call apps/api
NEXT_PUBLIC_DATA_SOURCE=demo
NEXT_PUBLIC_API_URL=http://localhost:4000
# Live site (http without presenter controls): real sign-in through Supabase Auth. Public values only — the anon key
# is safe in the browser (RLS denies everything); never put the service-role key here.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon or publishable key>
# Presenter controls (sample accounts, reset, early close) — local demos only; the API ignores them on a non-local database.
# NEXT_PUBLIC_DEMO_CONTROLS=true
