    "lint": "eslint .",
    "test": "vitest run",
    "db:seed": "tsx src/db/reseed.ts"
  },
  "dependencies": {
    "@auctionit/domain": "workspace:*",
    "cors": "2.8.6",
    "express": "5.3.0",
    "tsx": "4.23.15",
    "zod": "4.6.7",
    "@auctionit/client": "workspace:*",
    "postgres": "^3",
    "@supabase/supabase-js": "^2"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "^24",
    "@types/supertest": "^6",
    "supertest": "7.3.1",
    "vitest": "5.0.4"
  }
}
