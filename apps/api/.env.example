# apps/api — copy to .env. Never commit real values.
PORT=4000
# Comma-separated list of web origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:3000
# demo | supabase — demo serves seeded data without a database (Supabase arrives in Phase 2).
DATA_MODE=demo
# Server-only. Never expose to the browser. Needed from Phase 2.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
