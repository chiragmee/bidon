# apps/api — copy to .env. Never commit real values. Server-only: none of these reach the browser.
PORT=4000
# Comma-separated web origins allowed by CORS (your Vercel URL in production).
ALLOWED_ORIGINS=http://localhost:3000
# demo = in-memory seed (no database) | supabase = Postgres via DATABASE_URL
DATA_MODE=supabase
# Postgres connection string. Local Supabase (supabase start): postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
# Supabase project URL and service-role key — used only for Storage uploads (bucket lot-media).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Allow POST /demo/reset (reloads the sample data). Keep true for demo environments only.
DEMO_RESET_ENABLED=true
