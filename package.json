{
  "name": "auctionit",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm tokens && concurrently -k -n web,api -c cyan,magenta \"pnpm --filter @auctionit/web dev\" \"pnpm --filter @auctionit/api dev\"",
    "tokens": "pnpm --filter @auctionit/scripts tokens",
    "typecheck": "pnpm tokens && pnpm -r --parallel typecheck",
    "lint": "pnpm -r --parallel lint",
    "test": "pnpm -r test",
    "e2e": "playwright test",
    "build": "pnpm tokens && pnpm -r build",
    "format": "prettier --write .",
    "db:reset": "echo 'db:reset arrives in Phase 2 (Supabase). Use demo mode until then.' && exit 1",
    "demo:reset": "echo 'demo:reset arrives in Phase 3 (DemoDataSource).' && exit 1"
  },
  "devDependencies": {
    "@playwright/test": "^1",
    "concurrently": "10.0.6",
    "prettier": "^3",
    "typescript": "6.0.3",
    "eslint": "^9",
    "typescript-eslint": "8.71.2",
    "@eslint/js": "^9",
    "globals": "^16"
  }
}
