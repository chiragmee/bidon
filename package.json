{
  "name": "auctionit",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm generate && concurrently -k -n web,api -c cyan,magenta \"pnpm --filter @auctionit/web dev\" \"pnpm --filter @auctionit/api dev\"",
    "tokens": "pnpm generate",
    "typecheck": "pnpm generate && pnpm -r --parallel typecheck",
    "lint": "pnpm -r --parallel lint",
    "test": "pnpm -r test",
    "e2e": "playwright test",
    "build": "pnpm generate && pnpm -r build",
    "format": "prettier --write .",
    "db:reset": "supabase db reset && pnpm --filter @auctionit/api db:seed",
    "demo:reset": "pnpm --filter @auctionit/api db:seed || echo 'No database configured. In browser demo mode use \"Reset demo data\" in the header role menu.'",
    "generate": "pnpm --filter @auctionit/scripts generate",
    "e2e:http": "E2E_API_URL=http://localhost:4000 playwright test --project=desktop --workers=1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "concurrently": "10.0.6",
    "prettier": "^3",
    "typescript": "6.0.3",
    "eslint": "^9",
    "typescript-eslint": "8.71.2",
    "@eslint/js": "^9",
    "globals": "^16"
  }
}
